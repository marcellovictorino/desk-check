<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: no network keys, so all network access is denied. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- The only folder outside the app's container that Desk Check may read or write. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/.config/desk-check/</string>
	</array>
	<!-- Read-only, so a first launch can copy the settings the app kept under its old name, Desk Undo. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.config/desk-undo/</string>
	</array>
</dict>
</plist>
